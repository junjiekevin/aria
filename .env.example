# Aria v2.1 local environment contract (Phase 1)
# Copy to `.env` and replace placeholder values with real secrets where required.

# -----------------------------------------------------------------------------
# Web runtime (`apps/web` and compatibility `src/*`)
# -----------------------------------------------------------------------------
# Required: Supabase project URL for browser auth/data calls.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Required: Supabase anon/public key for browser auth/data calls.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional (default shown): base URL for `apps/api`.
VITE_API_BASE_URL=http://localhost:8787

# -----------------------------------------------------------------------------
# API runtime (`apps/api`)
# -----------------------------------------------------------------------------
# Optional fallback for API Supabase URL/key.
# If unset, API falls back to `VITE_SUPABASE_URL` / `VITE_SUPABASE_ANON_KEY`.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional (default shown): allowed web origin used during auth start flow.
WEB_ORIGIN=http://localhost:5173
# Optional (default shown): API port.
PORT=8787

# Conditionally required: webhook watch registration and inbound webhook validation.
GOOGLE_WEBHOOK_URL=
GOOGLE_WEBHOOK_TOKEN=
# Deprecated: webhook sync now runs via service-role execution in `apps/api`.
# SYSTEM_SYNC_USER_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Retained Supabase Edge Functions (`supabase/functions/*`)
# -----------------------------------------------------------------------------
# Required for retained edge functions using privileged database access.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Required for signed links used by publish/get-ics/cancel flows.
EDGE_LINK_SIGNING_SECRET=replace-with-long-random-secret

# Required for `supabase/functions/openrouter-chat`.
OPENROUTER_API_KEY=your-openrouter-api-key
# Required for `supabase/functions/publish-schedule` (optional send path in cancel-event).
RESEND_API_KEY=your-resend-api-key
